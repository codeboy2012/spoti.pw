[Unit]
Description=PwEevee server control tray icon
# Requires the freedesktop StatusNotifier/AppIndicator backend (see README).
# Adjust the path below if your checkout lives elsewhere.

[Service]
Type=simple
ExecStart=/usr/bin/env python3 %h/REPO/scripts/server-control/tray.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
