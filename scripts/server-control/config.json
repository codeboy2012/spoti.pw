{
  "$comment": "Servers controlled by scripts/serverctl (Linux) and scripts/win/ServerTray.exe (Windows). Polling checks raw TCP reachability; httpProbe is optional and best-effort.",
  "version": 1,
  "servers": [
    {
      "name": "website",
      "description": "PwEevee website preview server (static, perl)",
      "port": 4173,
      "httpProbe": "http://127.0.0.1:4173/",
      "probeTimeoutMs": 2500,
      "windows": {
        "exe": "C:\\Program Files\\Git\\usr\\bin\\perl.exe",
        "args": ["scripts\\dev-server.pl", "4173"],
        "workingDir": "<REPO_ROOT>",
        "logFile": "<REPO_ROOT>\\.freebuff\\website-server.log",
        "errFile": "<REPO_ROOT>\\.freebuff\\website-server.log.err"
      },
      "linux": {
        "exe": "perl",
        "args": ["scripts/dev-server.pl", "4173"],
        "workingDir": "<REPO_ROOT>",
        "logFile": ".freebuff/website-server.log",
        "errFile": ".freebuff/website-server.log.err"
      }
    }
  ]
}
