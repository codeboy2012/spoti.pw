#!/usr/bin/env bash
# serverctl — start/stop/restart/status for the project's local servers (Linux/macOS).
#
# usage:
#   serverctl status [name]        show status (all servers if no name)
#   serverctl start [name]         start a server (detached, survives the terminal)
#   serverctl stop [name]          stop a server
#   serverctl restart [name]       restart a server
#   serverctl install [name]       install + enable a systemd *user* service (Linux)
#   serverctl uninstall [name]     disable + remove the systemd user service
#   serverctl list                 list configured servers
#
# config: scripts/server-control/config.json (same file the Windows tray uses).
# python3 is used only for JSON parsing when available; otherwise a grep/sed
# fallback reads the flat config layout.

set -u

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CONFIG="${SERVERCTL_CONFIG:-$REPO_ROOT/scripts/server-control/config.json}"
STATE_DIR="$REPO_ROOT/.freebuff/server-control"
mkdir -p "$STATE_DIR"

die() { echo "serverctl: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# ---------- config reading -------------------------------------------------

json_get() {  # json_get <file> <python-expr using d=decoded whole-file>
  python3 - "$1" "$2" <<'PY' 2>/dev/null
import json, sys
with open(sys.argv[1]) as f:
    doc = json.load(f)
result = eval(sys.argv[2], {}, {"doc": doc})
if isinstance(result, list):
    print("\n".join(str(x) for x in result))
elif isinstance(result, dict):
    for k in sorted(result):
        print(k)
else:
    print(result)
PY
}

server_names() {
  if have python3; then json_get "$CONFIG" "[s['name'] for s in doc['servers']]"; else
    grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' "$CONFIG" | sed 's/.*"\([^"]*\)"$/\1/'
  fi
}

field() {  # field <server> <key>   (eval-safe values only: paths, ports, urls)
  local name="$1" key="$2"
  if have python3; then
    json_get "$CONFIG" "next(s['${key}'] for s in doc['servers'] if s['name']=='${name}')"
  else
    awk -v name="\"$name\"" -v key="\"$key\"" '
      $0 ~ /"name"/ && index($0, name) { inserver = 1 }
      inserver && index($0, key) {
        line = $0
        sub(/.*:[[:space:]]*/, "", line)
        gsub(/[",]/, "", line)
        print line
        exit
      }
      inserver && /}/ { inserver = 0 }' "$CONFIG"
  fi
}

plat_field() {  # plat_field <server> <platform> <key>  — resolves <REPO_ROOT>
  local name="$1" plat="$2" key="$3" v
  v=$(python3 - "$CONFIG" "$name" "$plat" "$key" <<'PY' 2>/dev/null
import json, sys
doc = json.load(open(sys.argv[1]))
for s in doc["servers"]:
    if s["name"] == sys.argv[2]:
        print(s.get(sys.argv[3], {}).get(sys.argv[4], ""))
        break
PY
  )
  echo "${v//<REPO_ROOT>/$REPO_ROOT}"
}

resolve_server() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    local count
    count=$(server_names | wc -l)
    if [ "$count" -eq 1 ]; then name="$(server_names)"; else
      die "multiple servers configured; pass one of: $(server_names | tr '\n' ' ')"
    fi
  fi
  server_names | grep -qx "$name" || die "unknown server '$name'. Known: $(server_names | tr '\n' ' ')"
  echo "$name"
}

# ---------- state helpers --------------------------------------------------

pidfile() { echo "$STATE_DIR/$1.pid"; }

port_up() {  # port_up <port>
  if have python3; then
    python3 -c "
import socket,sys
s = socket.socket()
s.settimeout(2.0)
rc = s.connect_ex(('127.0.0.1', int(sys.argv[1])))
s.close()
sys.exit(0 if rc == 0 else 1)
" "$1"
  elif have nc; then
    nc -z 127.0.1 "$1" >/dev/null 2>&1
  elif have curl; then
    curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$1/" 2>/dev/null
    [ $? -ne 7 ]
  else
    (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null && { exec 3>&- 3<&-; return 0; } || return 1
  fi
}

listener_pid() {  # best effort
  if have ss; then ss -lptn "sport = :$1" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2
  elif have lsof; then lsof -t -i ":$1" -sTCP:LISTEN 2>/dev/null | head -1
  fi
}

# ---------- commands -------------------------------------------------------

cmd_start() {
  local name; name="$(resolve_server "${1:-}")" || return $?
  local port; port="$(field "$name" port)"
  if port_up "$port"; then echo "$name already running (port $port up)"; return 0; fi

  local exe args work log err
  exe="$(plat_field "$name" linux exe)"
  work="$(plat_field "$name" linux workingDir)"
  log="$(plat_field "$name" linux logFile)"
  err="$(plat_field "$name" linux errFile)"
  args="$(python3 - "$CONFIG" "$name" <<'PY' 2>/dev/null
import json, sys
doc = json.load(open(sys.argv[1]))
for s in doc["servers"]:
    if s["name"] == sys.argv[2]:
        for a in s.get("linux", {}).get("args", []):
            print(a)
        break
PY
)"
  [ -n "$exe" ] || die "no linux exe configured for $name"
  [ -d "$work" ] || die "working directory not found: $work"
  mkdir -p "$(dirname "$log")"

  # fully detached: setsid detaches from the controlling terminal and session,
  # nohup guards against HUP, </dev/null plus file redirects drop all stdio
  # pipes so nothing keeps a parent terminal open.
  (
    cd "$work" || exit 1
    if have setsid; then
      setsid nohup "$exe" $args </dev/null >"$log" 2>"$err" &
    else
      nohup "$exe" $args </dev/null >"$log" 2>"$err" &
    fi
    echo $! > "$(pidfile "$name")"
  )

  for _ in $(seq 1 24); do
    sleep 0.25
    if port_up "$port"; then
      echo "$name started (pid $(cat "$(pidfile "$name")"), port $port up)"
      return 0
    fi
  done
  echo "$name launched (pid $(cat "$(pidfile "$name")")) but port $port is not up yet — check $err"
  return 1
}

cmd_stop() {
  local name; name="$(resolve_server "${1:-}")" || return $?
  local port; port="$(field "$name" port)"
  local pf; pf="$(pidfile "$name")"

  if ! port_up "$port"; then rm -f "$pf"; echo "$name already stopped (port $port down)"; return 0; fi

  local pids=""
  if [ -f "$pf" ]; then pids="$(cat "$pf")"; fi
  local lp; lp="$(listener_pid "$port")"
  [ -n "$lp" ] && [ "$lp" != "$pids" ] && pids="$pids $lp"

  local killed=0
  for pid in $pids; do
    kill "$pid" 2>/dev/null && killed=1
  done
  for _ in $(seq 1 16); do
    port_up "$port" || break
    sleep 0.25
    # escalate on the third check
    if [ "$_" = "3" ]; then
      for pid in $pids; do kill -9 "$pid" 2>/dev/null; done
    fi
  done
  rm -f "$pf"
  if port_up "$port"; then
    echo "$name: sent kill but port $port still up"; return 1
  fi
  [ "$killed" = 1 ] && echo "$name stopped" || echo "$name stopped (port $port released)"
  return 0
}

cmd_restart() {
  local name; name="$(resolve_server "${1:-}")" || return $?
  cmd_stop "$name" >/dev/null 2>&1
  sleep 0.3
  cmd_start "$name"
}

cmd_status() {
  local rc=0
  if [ $# -gt 0 ]; then
    local name; name="$(resolve_server "$1")" || return $?
    _status_one "$name" || rc=3
  else
    for n in $(server_names); do _status_one "$n" || rc=3; done
  fi
  return $rc
}

_status_one() {
  local name="$1"
  local port desc state pid
  port="$(field "$name" port)"
  desc="$(field "$name" description)"
  if port_up "$port"; then
    state="RUNNING"
    pid="$(listener_pid "$port")"
    [ -n "$pid" ] && pid=" pid $pid"
  else
    state="STOPPED"; pid=""; rc=3
  fi
  printf '%-10s %-12s port %-6s%s  %s\n' "$state" "$name" "$port" "$pid" "$desc"
  [ "$state" = "RUNNING" ]
}

cmd_install() {  # systemd user service
  local name; name="$(resolve_server "${1:-}")" || return $?
  have systemctl || die "systemctl not found — use 'serverctl start $name' directly"
  local exe args work log
  exe="$(plat_field "$name" linux exe)"
  work="$(plat_field "$name" linux workingDir)"
  log="$(plat_field "$name" linux logFile)"
  args="$(python3 - "$CONFIG" "$name" <<'PY' 2>/dev/null
import json, sys
doc = json.load(open(sys.argv[1]))
for s in doc["servers"]:
    if s["name"] == sys.argv[2]:
        print(" ".join("'" + a.replace("'", "'\\''") + "'" for a in s.get("linux", {}).get("args", [])))
        break
PY
)"
  local unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/system/user"
  mkdir -p "$unit_dir"
  local unit="pweevee-$name.service"
  cat > "$unit_dir/$unit" <<EOF
[Unit]
Description=PwEevee server: $name ($(_field_desc "$name"))
After=network.target

[Service]
Type=simple
WorkingDirectory=$work
ExecStart=$exe $args
Restart=on-failure
RestartSec=2
StandardOutput=append:$log
StandardError=append:${log}.err

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload || die "daemon-reload failed"
  systemctl --user enable --now "$unit" || die "enable $unit failed"
  echo "installed and started systemd user service: $unit"
  echo "  logs: $log / $log.err"
  echo "  remove with: serverctl uninstall $name"
}

_field_desc() { field "$1" description 2>/dev/null || echo "$1"; }

cmd_uninstall() {
  local name; name="$(resolve_server "${1:-}")" || return $?
  local unit="pweevee-$name.service"
  have systemctl || die "systemctl not found"
  systemctl --user disable --now "$unit" 2>/dev/null
  rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/system/user/$unit"
  systemctl --user daemon-reload 2>/dev/null
  echo "removed $unit"
}

cmd_list() {
  for n in $(server_names); do
    printf '%-12s %s\n' "$n" "$(field "$n" description)"
  done
}

case "${1:-help}" in
  start)    shift; cmd_start "$@" ;;
  stop)     shift; cmd_stop "$@" ;;
  restart)  shift; cmd_restart "$@" ;;
  status)   shift; cmd_status "$@" ;;
  list|servers) cmd_list ;;
  install)  shift; cmd_install "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  *) sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
